@model ProductVM
@{
    const int qunatity = 500;
}
<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">All Products</h2>
        </div>
        <div class="col-md-6 text-md-end text-start mt-2 mt-md-0">
            <a href="/Admin/Product/Create" class="btn btn-success">
                <i class="bi bi-plus-circle"></i>
                Create
            </a>
        </div>
    </div>



    <form class="row g-3">
        <div class="col-4 mb-3">
            <label for="name" class="form-label">Name</label>
            <input class="form-control" name="ProductName" value="@ViewBag.Name" />
        </div>

        <div class="col-4 mb-3">
            <label for="MinPrice" class="form-label">Min Price</label>
            <input type="number" class="form-control" name="MinPrice" value="@ViewBag.MinPrice" />
        </div>

        <div class="col-4 mb-3">
            <label for="MaxPrice" class="form-label">Max Price</label>
            <input type="number" class="form-control" name="MaxPrice" value="@ViewBag.MaxPrice" />
        </div>


        <div class="col-4 mb-3">
            <label for="CategoryId" class="form-label">Category</label>
            <select class="form-control" name="CategoryId">
                <option>select category</option>
                @if (ViewData["Categories"] is IEnumerable<Category> categories)
                {
                    @foreach (var item in categories)
                    {

                        if (item.Id == ViewBag.CategoryId)
                        {
                            <option value="@item.Id" selected>@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    }

                }
            </select>
        </div>

        <div class="col-4 mb-3">
            <label for="BrandId" class="form-label">Brand</label>
            <select class="form-control" name="BrandId">
                <option>select brand</option>
                @if (ViewData["Brands"] is IEnumerable<Brand> brands)
                {
                    @foreach (var item in brands)
                    {

                        if (item.Id == ViewBag.BrandId)
                        {
                            <option value="@item.Id" selected>@item.Name</option>
                        }
                        else
                        {
                            <option value="@item.Id">@item.Name</option>

                        }

                    }

                }
            </select>
        </div>


        <div class="col-4 mb-3 d-flex justify-content-center align-items-center">
            <label for="IsLowQuantity" class="form-label mx-3">Is Low Quantity</label>
            <input type="checkbox" class="" name="IsLowQuantity" value="True" @(ViewBag.IsLowQuantity != null && ViewBag.IsLowQuantity ? "checked" : "") />
        </div>

        <button type="submit" class="btn btn-dark col-2">Filter</button>
    </form>




    <div class="row">
        <div class="col-12">

            <table class="table table-hover">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Name</th>
                        <th scope="col">Price</th>
                        <th scope="col">Quantity</th>
                        <th scope="col">Category Name</th>
                        <th scope="col">Barand Name</th>
                        <th scope="col">Status</th>
                        <th scope="col">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Products)
                    {
                        <tr>
                            <th scope="row">@item.Id</th>
                            <td>@item.Name</td>
                            <td>@item.Price</td>

                            <td>
                                @if (item.Quantity > qunatity)
                                {
                                    <span class="badge text-bg-success">
                                        @item.Quantity
                                    </span>
                                }
                                else
                                {

                                    <span class="badge text-bg-danger">
                                        @item.Quantity
                                    </span>

                                }
                            </td>
                            <td>@item.Category.Name</td>
                            <td>@item.Brand.Name</td>

                            <td>
                                @if (item.Status)
                                {
                                    <span class="badge text-bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {

                                    <span class="badge text-bg-danger">
                                        InActive
                                    </span>

                                }
                            </td>
                            <td>
                                <a href="/Admin/Product/Edit/@item.Id" type="button" class="btn btn-warning">
                                    <i class="bi bi-pencil"></i>
                                    Edit
                                </a>
                                <a href="/Admin/Product/Delete/@item.Id" class="btn btn-danger btn-delete">
                                    <i class="bi bi-trash3"></i>
                                    Delete
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <nav aria-label="Page navigation example">
        <ul class="pagination d-flex justify-content-center align-items-center">
            <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                <a class="page-link" href="/Admin/Product/Index?name=@ViewBag.name&page=@(Model.CurrentPage - 1)" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>


            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item"><a class="page-link @(Model.CurrentPage == i ? "active" : "")" href="/Admin/Product/Index?name=@ViewBag.name&page=@i">@i</a></li>
            }
            <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="/Admin/Product/Index?name=@ViewBag.name&page=@(Model.CurrentPage + 1)" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>

<script>
    document.querySelectorAll(".btn-delete").forEach(button => {

        button.addEventListener("click", function (e) {

            e.preventDefault();

            let deleteUrl = this.getAttribute("href");

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#d33",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {

                if (result.isConfirmed) {

                    window.location.href = deleteUrl;

                }

            });

        });

    });
</script>