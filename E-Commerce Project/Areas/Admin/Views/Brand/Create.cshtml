@model CreateBrandVM
<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">Create new Brand</h2>
        </div>
    </div>

    <div class="row my-3">
        <div class="col-12">
            <form method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="name" class="form-label">Name</label>
                    <input class="form-control" name="Name" value="@Model.Name"/>
                    <span class="text-danger" asp-validation-for="Name"></span>
                </div>
                <div class="mb-3">
                    <label for="name" class="form-label">Logo</label>
                    <input type="file" class="form-control" accept="image/*" name="ImageFile" />
                    <span class="text-danger" asp-validation-for="ImageFile"></span>

                </div>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <div class="form-floating">
                        <textarea name="Description" class="form-control" placeholder="Leave a description here" style="height: 100px">@Model.Description</textarea>
                        <label for="description">You Description Here...</label>

                    </div>
                    <span class="text-danger" asp-validation-for="Description"></span>

                </div>
                <div class="mb-3">
                    <label for="status" class="form-label">Status</label>
                    <select class="form-select" name="Status">
                        <option value="True" selected>Active</option>
                        <option value="False">InActive</option>
                    </select>
                    <span class="text-danger" asp-validation-for="Status"></span>

                </div>
                <button type="submit" class="btn btn-primary">Submit</button>
            </form>
        </div>
    </div>
</div>

