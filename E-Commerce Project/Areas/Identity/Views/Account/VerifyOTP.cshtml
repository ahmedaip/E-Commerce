@model E_Commerce_Project.ViewModels.VerifyOTPVM

@{
    ViewData["Title"] = "Verify OTP";
}
<div class="container">

    <hr />
    <div class="row">
        <div class="col-md-12">
            <form asp-action="VerifyOTP">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <input asp-for="UserId" hidden class="form-control" />

                <div class="form-group">
                    <label asp-for="OTP" class="control-label"></label>
                    <input asp-for="OTP" class="form-control" />
                    <span asp-validation-for="OTP" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Verify" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    <div>
        <a asp-action="ForgetPassword">Forget Password</a>
    </div>

</div>