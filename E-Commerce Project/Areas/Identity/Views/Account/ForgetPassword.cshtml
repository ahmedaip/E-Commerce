@model E_Commerce_Project.ViewModels.ForgetPasswordVM

@{
    ViewData["Title"] = "Forget Password";
}
<div class="container">

    <hr />
    <div class="row">
        <div class="col-md-12">
            <form asp-action="ForgetPassword">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group">
                    <label asp-for="UserNameOrEmail" class="control-label"></label>
                    <input asp-for="UserNameOrEmail" class="form-control" />
                    <span asp-validation-for="UserNameOrEmail" class="text-danger"></span>
                </div>

                <div class="form-group mt-3">
                    <input type="submit" value="Forget Password" class="btn btn-primary" />
                </div>
            </form>
        </div>
    </div>

    <div>
        <a asp-action="Login">Login</a>
    </div>

</div>